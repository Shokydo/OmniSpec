{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSpec",
  "version": "0.1.4",
  "identifier": "ru.omnispec.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OmniSpec",
        "width": 1400,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0b0d",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "OmniSpec — лаунчер Minecraft для офлайн-аккаунтов: сборки, моды и модпаки с Modrinth, автоматическая Java."
  }
}
